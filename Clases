"""
Módulo Clases: Define la estructura de nodos, pacientes, lista enlazada y pila.
"""

class Nodo:
    """Nodo individual para listas enlazadas y pilas."""
    def __init__(self, paciente):
        self.paciente = paciente
        self.siguiente = None


class Paciente:
    """Almacena la información de cada paciente."""
    def __init__(self, documento, nombre, edad, motivo, nivel_triage, hora_llegada):
        self.documento = documento
        self.nombre = nombre
        self.edad = edad
        self.motivo = motivo
        self.nivel_triage = nivel_triage
        self.hora_llegada = hora_llegada


class ListaEnlazada:
    """Estructura de datos lineal para gestionar el registro de pacientes."""
    def __init__(self):
        self.cabeza = None
        self.tamaño = 0

    def registrar_paciente(self, paciente):
        """Agrega un nuevo paciente al final de la lista."""
        nuevo_nodo = Nodo(paciente)
        if self.cabeza is None:
            self.cabeza = nuevo_nodo
        else:
            actual = self.cabeza
            while actual.siguiente is not None:
                actual = actual.siguiente
            actual.siguiente = nuevo_nodo
        self.tamaño += 1

    def mostrar_pacientes(self):
        """Imprime todos los pacientes de la lista."""
        if self.cabeza is None:
            print("No hay pacientes registrados.")
            return

        actual = self.cabeza
        while actual is not None:
            p = actual.paciente
            print(f"Documento: {p.documento}\nNombre: {p.nombre}\nEdad: {p.edad}\nMotivo: {p.motivo}\nTriage: {p.nivel_triage}\nHora de llegada: hace {p.hora_llegada} min\n")
            actual = actual.siguiente

    def buscar_por_documento(self, documento):
        """Busca un paciente por su número de documento."""
        if self.cabeza is None:
            print("No hay pacientes en el registro.")
            return None

        actual = self.cabeza
        contador = 0

        while actual is not None:
            contador += 1
            if actual.paciente.documento == documento:
                p = actual.paciente
                print(f"Paciente encontrado en {contador} comparaciones:")
                print(f"Documento: {p.documento}, Nombre: {p.nombre}, Triage: {p.nivel_triage}")
                return p
            actual = actual.siguiente

        print(f"Paciente no encontrado ({contador} comparaciones realizadas).")
        return None

    def dar_de_alta(self, documento):
        """Retira a un paciente de la lista por su documento y lo retorna."""
        if self.cabeza is None:
            return None

        if self.cabeza.paciente.documento == documento:
            paciente_alta = self.cabeza.paciente
            self.cabeza = self.cabeza.siguiente
            self.tamaño -= 1
            return paciente_alta

        actual = self.cabeza
        while actual.siguiente is not None:
            if actual.siguiente.paciente.documento == documento:
                paciente_alta = actual.siguiente.paciente
                actual.siguiente = actual.siguiente.siguiente
                self.tamaño -= 1
                return paciente_alta
            actual = actual.siguiente

        return None

    def contar_pacientes_por_nivel_triage(self, nodo_actual, nivel_triage):
        """Cuenta de forma recursiva los pacientes según su nivel de triage."""
        if nodo_actual is None:
            return 0
        coincidencia = 1 if nodo_actual.paciente.nivel_triage == nivel_triage else 0
        return coincidencia + self.contar_pacientes_por_nivel_triage(nodo_actual.siguiente, nivel_triage)


class PilaEnlazada:
    """Estructura LIFO para guardar el historial de acciones."""
    def __init__(self):
        self.cima = None
        self.tamaño = 0

    def apilar(self, dato):
        """Inserta un elemento en la cima de la pila."""
        nuevo_nodo = Nodo(dato)
        self.tamaño += 1
        if self.cima is None:
            self.cima = nuevo_nodo
        else:
            nuevo_nodo.siguiente = self.cima
            self.cima = nuevo_nodo

    def desapilar(self):
        """Extrae y retorna el elemento de la cima."""
        if self.cima is None:
            return None
        dato = self.cima.paciente
        self.cima = self.cima.siguiente
        self.tamaño -= 1
        return dato

    def esta_vacia(self):
        """Retorna True si la pila no tiene elementos."""
        return self.cima is None

    def obtener_tamaño(self):
        """Retorna la cantidad total de elementos en la pila."""
        return self.tamaño
