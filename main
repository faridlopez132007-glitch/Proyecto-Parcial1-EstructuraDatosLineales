"""
Módulo Main: Flujo de ejecución del sistema hospitalario.
"""
import Clases
import Funciones

def main():
    lista = Clases.ListaEnlazada()

    print("=== FASE 1: EVALUACIÓN DEL SISTEMA ===")

    # 1. Registro inicial de 3 pacientes (alternando triages 1 y 3)
    lista, historial, tiempo, id_doc = Funciones.pacientes_aleatorios(lista, 0, 0, 3, False, (1, 3))

    # 2. Mostrar la lista inicial
    print("\n--- Lista Inicial de Pacientes ---")
    lista.mostrar_pacientes()

    # 3. Buscar paciente con documento 222
    print("--- Búsqueda por Documento (222) ---")
    lista.buscar_por_documento(222)

    # 4. Dar de alta al paciente 222
    print("\n--- Alta Médica (222) ---")
    paciente_eliminado = lista.dar_de_alta(222)
    if paciente_eliminado:
        historial.apilar({"accion": "dar_alta", "paciente": paciente_eliminado})
        print(f"Paciente {paciente_eliminado.nombre} dado de alta con éxito.")
    else:
        print("No se encontró al paciente.")

    print("\n--- Lista tras el Alta ---")
    lista.mostrar_pacientes()

    # 5. Deshacer la última acción realizada
    print("--- Deshacer Última Acción ---")
    Funciones.deshacer_ultima_accion(lista, historial)

    print("\n--- Lista tras Deshacer ---")
    lista.mostrar_pacientes()

    # 6. Conteo recursivo de pacientes con Triage 3
    print("--- Conteo Recursivo (Triage 3) ---")
    total_triage_3 = lista.contar_pacientes_por_nivel_triage(lista.cabeza, 3)
    print(f"Total de pacientes con Triage 3: {total_triage_3}\n")

    # FASE 2: Simulación aleatoria adicional
    print("=== FASE 2: PRUEBA DE CARGA ===")
    lista, historial, tiempo, id_doc = Funciones.pacientes_aleatorios(lista, tiempo, id_doc, 4, False, (1, 2, 3, 4, 5))

    print("\n--- Lista Final del Hospital ---")
    lista.mostrar_pacientes()

if __name__ == "__main__":
    main()
